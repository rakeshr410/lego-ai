{
  "name": "lego-ai-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "predev": "node scripts/copy-excalidraw.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-excalidraw.mjs",
    "build": "astro build",
    "check:dist": "node scripts/check-dist.ts",
    "coaching": "node scripts/coaching.ts",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node scripts/serve.ts",
    "typecheck": "astro sync && astro check && tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:interview": "vitest run -c vitest.eval.config.ts eval/interview",
    "eval:kappa": "node scripts/interview-kappa.ts",
    "interview:cost": "node scripts/interview-cost-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@pipecat-ai/client-js": "^1.14.0",
    "@pipecat-ai/daily-transport": "^1.7.0",
    "@sentry/browser": "^11.0.0",
    "@sentry/node": "^11.0.0",
    "astro": "^7.3.5",
    "ioredis": "^5.11.1",
    "minisearch": "^7.2.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-vitals": "^6.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@arrowbox/content-kit": "file:../../lego/content-kit",
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
