---
// The site footer (design 14a), on the header's midnight: a closing call to action (the roadmaps
// and the systems), then the logo and its line beside three columns of links (the stacks, what
// there is to learn, Arrowbox itself), then the brand notice and the legal links. "My dashboard"
// follows the header's (FLAGS.dashboardLink), "Pricing" the billing flag.
import Logo from './Logo.astro';
import { FLAGS } from '../lib/flags';
import { getTracks } from '../lib/sd';
import tp from '../i18n/messages/pages';
import { BRAND_NOTICE, CONTACT_EMAIL, LEGAL_LINKS } from './legal';
import '../styles/components/site-footer.css';

const STACKS = ['frontend', 'backend', 'ml', 'agentic'];
const tracks = await getTracks();
const stacks = STACKS.flatMap((slug) => {
  const track = tracks.find((x) => x.slug === slug);
  return track ? [{ href: `/tracks/${slug}`, label: track.name }] : [];
});
const columns = [
  { title: tp('footer.stacks'), links: stacks },
  {
    title: tp('footer.learn'),
    links: [
      { href: '/tracks', label: tp('footer.systems') },
      { href: '/roadmap', label: tp('footer.roadmaps') },
      ...(FLAGS.dashboardLink ? [{ href: '/dashboard', label: tp('footer.dashboard') }] : []),
    ],
  },
  {
    title: tp('footer.brand'),
    links: [
      ...(FLAGS.billing ? [{ href: '/pricing', label: tp('footer.pricing') }] : []),
      { href: '/faq', label: tp('footer.faq') },
      { href: `mailto:${CONTACT_EMAIL}`, label: tp('footer.contactShort') },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="site-foot__cta">
    <div class="site-foot__wrap site-foot__cta-row">
      <div>
        <p class="site-foot__cta-title">{tp('footer.cta.title')}</p>
        <p class="site-foot__cta-text">{tp('footer.cta.text')}</p>
      </div>
      <div class="site-foot__cta-btns">
        <a href="/roadmap" class="site-foot__btn site-foot__btn--accent" data-astro-prefetch>{tp('footer.cta.roadmaps')}</a>
        <a href="/tracks" class="site-foot__btn" data-astro-prefetch>{tp('footer.cta.systems')}</a>
      </div>
    </div>
  </div>

  <div class="site-foot__wrap">
    <div class="site-foot__main">
      <div class="site-foot__brand">
        <a href="/" class="site-foot__logo" aria-label={tp('header.home')}>
          <Logo title={null} />
        </a>
        <p>{tp('footer.tagline')}</p>
      </div>
      {
        columns.map((c) => (
          <nav class="site-foot__col" aria-label={c.title}>
            <p class="site-foot__col-title">{c.title}</p>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-foot__legal">
      <p class="site-foot__notice">{BRAND_NOTICE}</p>
      <div class="site-foot__end">
        <nav class="site-foot__nav" aria-label={tp('footer.nav')}>
          {LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={`mailto:${CONTACT_EMAIL}`}>{tp('footer.contact')}</a>
          <button type="button" class="site-foot__link" data-consent-open>{tp('footer.privacyChoices')}</button>
        </nav>
        <p class="site-foot__copy">{tp('footer.copyright', { year: String(year) })}</p>
      </div>
    </div>
  </div>
</footer>
