---
// The Arrowbox logo for static pages: the same drawing as Logo.tsx, inline (no request, no JS).
// Props as Logo.tsx: variant 'wordmark' | 'mark', size (wordmark font size or mark size, px),
// tone 'light' | 'dark', title (accessible name; null when visible text already names it).
import { logoBox, logoClass, type LogoProps } from './Logo';
import { MARK_SHAPES, WORDMARK_COMPACT_SHAPES, WORDMARK_SHAPES } from './logo-paths';

type Props = LogoProps;
const { variant = 'wordmark', tone, title = 'Arrowbox', className } = Astro.props;
const size = Astro.props.size ?? (variant === 'mark' ? 32 : 20);
const b = logoBox(variant, size);
const g = b.id === 'wordmark' ? WORDMARK_SHAPES : WORDMARK_COMPACT_SHAPES;
const markStroke = b.id === 'mark-small' ? MARK_SHAPES.strokeSmall : MARK_SHAPES.stroke;
const a11y = title ? { role: 'img' as const, 'aria-label': title } : { 'aria-hidden': 'true' as const };
---

<svg
  class={logoClass(tone, className)}
  width={b.width}
  height={b.height}
  viewBox={b.viewBox}
  fill="none"
  focusable="false"
  style={b.overhang ? `margin-bottom: -${b.overhang}px` : undefined}
  {...a11y}
>
  {
    variant === 'mark' ? (
      <>
        <rect {...MARK_SHAPES.rect} stroke="currentColor" stroke-width={markStroke} />
        <path d={MARK_SHAPES.arrow} class="ab-logo__accent" stroke-width={markStroke} stroke-linecap="round" stroke-linejoin="round" />
      </>
    ) : (
      <>
        <rect x={g.rect.x} y={g.rect.y} width={g.rect.width} height={g.rect.height} stroke="currentColor" stroke-width={g.rect.stroke} />
        <path d={g.arrow} fill="currentColor" />
        <path d={g.box} fill="currentColor" />
        <g class="ab-logo__accent" stroke-width={g.connector.stroke}>
          <circle cx={g.connector.circle.cx} cy={g.connector.circle.cy} r={g.connector.circle.r} class="ab-logo__dot" />
          <path d={g.connector.line} />
          <path d={g.connector.head} stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </>
    )
  }
</svg>
