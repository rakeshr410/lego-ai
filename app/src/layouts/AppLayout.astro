---
import '../styles/fonts.css';
import '../styles/sd.css';
import '../styles/site.css';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { AUTH_HEAD_SCRIPT, HINT } from '../lib/auth-state';
import { LANG } from '../i18n';
import tp from '../i18n/messages/pages';

interface Props {
  title: string;
  description?: string | null;
  bodyClass?: string;
  /** Keeps the page out of search results and the sitemap (placeholder, thin and utility pages). */
  noindex?: boolean;
  /** Open Graph type: `article` for topic pages. */
  type?: 'website' | 'article';
  /** ISO date-time of the last content change (articles). */
  modified?: string | null;
  /** Structured data for the page (lib/seo.ts builders). */
  jsonLd?: object[];
  /** Pages that fill the viewport with their own scroller render SiteFooter themselves. */
  footer?: boolean;
  /** The URL path the page is served at, when it is built at another (a topic's Free variant). */
  path?: string;
}

const { title, description, bodyClass, noindex, type, modified, jsonLd, footer = true, path } = Astro.props;
// `astro dev` renders topic pages without the request's cookies, so the server's gate
// (lib/server/gate.ts) can't run there. In dev only, a topic page sends a browser with no
// signed-in hint to sign in and back; builds are gated on the server. A public topic (pricing.yaml
// free.publicSystems) is the one topic page without noindex, and anyone reads it, so it is let through.
const devTopicGate =
  import.meta.env.DEV && noindex && /^\/systems\/[^/]+\/(?!interview\/?$)[^/]+\/?$/.test(Astro.url.pathname)
    ? `if(!${HINT.toString()}.test(document.cookie))location.replace(${JSON.stringify('/signin?next=')}+encodeURIComponent(location.pathname+location.search))`
    : null;
---

<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Signed in or not, before the first paint: links into topics read "Sign in to …" when not (lib/auth-state.ts). */}
    <script is:inline set:html={AUTH_HEAD_SCRIPT} />
    {devTopicGate && <script is:inline set:html={devTopicGate} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbfaf7" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <Seo title={title} description={description} noindex={noindex} type={type} modified={modified} jsonLd={jsonLd} path={path} />
    <link rel="preload" href="/fonts/merriweather-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">{tp('skip')}</a>
    <slot />
    {footer && <SiteFooter />}
    <ConsentBanner />
    <script>
      // Core Web Vitals from a sample of page views (src/lib/rum.ts); nothing loads for the rest.
      import { startRum } from '../lib/rum';
      // Privacy choices (P3-2): the banner, and analytics only once the reader allows it.
      import { startConsent } from '../lib/consent-ui';
      void startRum();
      startConsent();
    </script>
  </body>
</html>
