# lego-ai's server settings are declared, typed and checked in src/lib/server/env.ts (SETTINGS): a
# malformed value is logged and ignored in dev, and a production server refuses to serve until it is
# fixed. Build-time settings (PUBLIC_*) are read by `astro build`.

# ---- The main site (lego/web) ---------------------------------------------------------------
# Where this app reaches the main site on the private network, to ask who a session cookie belongs
# to (src/lib/server/session.ts). Dev: the main site's dev server.
WEB_INTERNAL_URL=http://localhost:4321
# The bearer between the two, both ways: this app presents it to /api/internal/reader, and the main
# site presents it to /api/internal/interview/readers/* (account export and deletion). 32+
# characters; the main site's LEGO_AI_SECRET must be the same value. `openssl rand -base64 33`
LEGO_AI_SECRET=
# Dev only: the main site's dev server, which this one proxies every path it doesn't serve to
# (astro.config.mjs). Browse the whole site at http://localhost:4322.
WEB_DEV_URL=http://localhost:4321

# Claude API key (server-side only)
ANTHROPIC_API_KEY=

# Public site origin, e.g. https://arrowbox.example. Used for same-origin checks, Secure
# (__Host-) session cookies, HSTS, redirects and email links. Required in production; set it
# at build time too (it configures Astro's trusted host). Unset in dev: the request origin is used.
PUBLIC_ORIGIN=

# Shared store for the interview's sessions, quotas, rate limits and the gateway's budget and kill
# switch, e.g. redis://localhost:6379. Use the main site's Redis (the same REDIS_URL): the model
# budget, Ask's kill switch and the interview's existing sessions are kept there. Optional in dev
# (in-memory, one process only); required by a production build.
REDIS_URL=

# Client IP for rate limits behind proxies; production requires one of the two. TRUST_PROXY =
# how many proxies append to X-Forwarded-For in front of this server (1 for a single load
# balancer, 2 for CDN + LB); the client IP is taken that many entries from the right. Or name a
# header the edge overwrites with the client IP (e.g. cf-connecting-ip, fly-client-ip); it wins
# when present. Leave both empty in dev (no proxy): the socket address is used.
TRUST_PROXY=
CLIENT_IP_HEADER=

# Send Content-Security-Policy-Report-Only instead of enforcing it (for rollout).
CSP_REPORT_ONLY=false

# Build-time settings. The interview's own:
# Mock interview pages and API (docs/README.md). Off: no pages, and /api/interview answers 404.
# The main site's own PUBLIC_INTERVIEW_ENABLED decides whether its pages link here.
PUBLIC_INTERVIEW_ENABLED=false
# The interview room's whiteboard (phase 2b, docs/README.md "Whiteboard"): the canvas in
# the room, and the room page's CSP (a worker from a blob URL). Needs PUBLIC_INTERVIEW_ENABLED.
PUBLIC_INTERVIEW_BOARD_ENABLED=false
# The interview room's voice part (phase 2, docs/README.md "Voice"): the second start
# button (Pro), the voice room with Daily's client, and the room page's CSP (Daily's hosts) and
# Permissions-Policy (microphone=(self)). Needs PUBLIC_INTERVIEW_ENABLED and, at runtime, the
# INTERVIEW_VOICE_* settings and the vendor keys below.
PUBLIC_INTERVIEW_VOICE_ENABLED=false
# Early access (docs/README.md "Rollout"): the systems with a mock interview, as slugs,
# comma-separated. Empty: every system with a published plan. A page, an entry point and a plan
# exist only for the listed systems.
PUBLIC_INTERVIEW_SYSTEMS=
# The rest decide the site's header and footer, which this app renders too (src/layouts/): build
# with the same values as the main site.
PUBLIC_ASK_ENABLED=false
PUBLIC_LABS_ENABLED=false
PUBLIC_AGENT_LABS_ENABLED=false
PUBLIC_BILLING=false
PUBLIC_GOOGLE_SIGNIN=false
PUBLIC_DASHBOARD_LINK=true
PUBLIC_PRICING_REVIEWS=false
# Only list and build topics whose reviewStatus is "reviewed". Must be true in production.
PUBLIC_REVIEWED_ONLY=false
# Contact / takedown address shown on the legal pages and footer. Placeholder until set.
PUBLIC_CONTACT_EMAIL=
# The privacy and grievance inbox named on /legal/privacy (privacy requests, DPDP grievances).
PUBLIC_PRIVACY_EMAIL=

# ---- The model gateway (src/lib/server/llm-gateway.ts) ------------------------------------
# Shared with the main site's Ask mode: every interview call passes its kill switch (ASK_ENABLED, or
# the store flag `node ../../lego/web/scripts/ask-switch.mjs on|off` sets), ASK_DAILY_BUDGET_USD (the
# account-wide breaker) and ASK_MAX_CONCURRENCY. Keep them the same as the main site's.
ASK_ENABLED=false
# Model and effort. Must be a model listed in llm-gateway.ts (claude-opus-5, claude-sonnet-5, ...).
ASK_MODEL=claude-opus-5
ASK_EFFORT=low
# Output cap per answer (answers are ~90 words; the rest is headroom for low-effort thinking).
ASK_MAX_TOKENS=1500
# Questions per reader per UTC day, by plan (the user's plan field in Strapi; everyone is on
# free until billing exists, see src/lib/server/entitlements.ts).
ASK_DAILY_QUOTA=20
ASK_DAILY_QUOTA_PRO=200
ASK_DAILY_QUOTA_STAFF=500
# Estimated spend per UTC day across all readers; Ask pauses until midnight UTC once reached.
# Also set a spend limit on the production Anthropic workspace as a backstop. Size it for
# production from docs/capacity-model.md (about $340 a day at the modelled launch traffic).
ASK_DAILY_BUDGET_USD=20
# Claude calls in flight per process; more wait up to ASK_QUEUE_MS, then get a 503. Size it
# for production from docs/capacity-model.md (about 38 per instance with two instances).
ASK_MAX_CONCURRENCY=8
ASK_QUEUE_MS=5000
# Wall-clock limit per question, streaming included, retries and their waits too.
ASK_TIMEOUT_MS=40000
# Retries of a brief overload (529, 5xx, a connection that never came up; never a 429, never once
# the answer has started), after Anthropic's Retry-After plus a random backoff. A wait longer than
# ASK_RETRY_MAX_WAIT_MS, or one that would leave under half of ASK_TIMEOUT_MS, is not retried:
# the reader gets a 503 + Retry-After at once. Retries are also capped per process at one a
# second plus one per five calls, so an outage doesn't multiply the load on Anthropic.
ASK_MAX_RETRIES=2
ASK_RETRY_MAX_WAIT_MS=5000
# Alert (a level "alert" log line) when the share of prompt tokens read from the prompt cache,
# over this process's last 100 calls, drops below this fraction. Warm topics should be >= 0.8.
ASK_CACHE_READ_ALERT=0.6
# ---- end model gateway ---------------------------------------------------------------------

# ---- Mock interview (src/lib/server/interview/, docs/README.md) -------------------
# Only used by a build with PUBLIC_INTERVIEW_ENABLED=true. Every call also passes Ask's kill
# switch and ASK_DAILY_BUDGET_USD (the account-wide breaker), and ASK_MAX_CONCURRENCY.
# Runtime pause; a store flag set with `node scripts/interview-switch.mjs on|off` overrides it.
INTERVIEW_ENABLED=true
# The turn-by-turn interviewer (default claude-sonnet-5) and the one feedback pass at the end
# (default claude-opus-5). Models listed in llm-gateway.ts only.
INTERVIEW_MODEL=claude-sonnet-5
# The voice interviewer's turns: a faster model when the spoken reply's wait matters (default: INTERVIEW_MODEL).
# Measured 2026-10-24 on the interviewer's prompt: Sonnet 5 first token ~1.45 s, Haiku 5.5 ~0.85 s.
# INTERVIEW_VOICE_MODEL=claude-haiku-5-5
# Where Claude is served from (llm-gateway.ts "Provider"; docs/README.md "Latency"). The
# default is Anthropic's API (US). `bedrock` calls Claude in Amazon Bedrock from BEDROCK_REGION with
# BEDROCK_API_KEY (a Bedrock API key from the console, sent as the bearer); from ap-south-1 a model
# with an India geo profile (Sonnet 5, Opus 5, Haiku 4.5) is served in-country, the others globally.
# BEDROCK_GEO forces a profile (in, us, eu, jp, au, global); BEDROCK_MODEL_IDS names ids outright,
# e.g. claude-haiku-5-5=global.anthropic.claude-haiku-5-5. Regional profiles cost 10% more.
LLM_PROVIDER=anthropic
BEDROCK_REGION=ap-south-1
BEDROCK_API_KEY=
# The speculative start: the voice service posts the words heard at the VAD's stop and the reply
# begins on them before the turn is confirmed (one unused call when the words change).
INTERVIEW_VOICE_SPECULATE=true
INTERVIEW_FEEDBACK_MODEL=claude-opus-5
INTERVIEW_EFFORT=low
INTERVIEW_MAX_TOKENS=700
INTERVIEW_FEEDBACK_MAX_TOKENS=4000
INTERVIEW_FEEDBACK_EFFORT=high
INTERVIEW_FEEDBACK_TIMEOUT_MS=120000
# The per-turn evaluator tags each candidate message against the stage's coverage items (default
# claude-haiku-5-5) so the interviewer knows what is covered; off leaves it to the clock.
INTERVIEW_EVALUATOR=true
INTERVIEW_EVALUATOR_MODEL=claude-haiku-5-5
# Thinking counts against it: 1000 cut off the tags on long answers.
INTERVIEW_EVALUATOR_MAX_TOKENS=3000
# The whiteboard's model fallbacks per stage, on the evaluator's model: box labels the matcher
# could not place (one batched call), and a description of a mostly freehand board (vision).
INTERVIEW_BOARD_MATCH_CALLS=4
INTERVIEW_BOARD_VISION_CALLS=2
# Sessions a reader may start per calendar month (UTC), and candidate messages per session.
INTERVIEW_MONTHLY_SESSIONS=3
# Drills (a topic's or one section's short interview, docs/README.md "Drills") a reader
# may start per month, text or voice: their own allowance, apart from the whole interviews.
INTERVIEW_MONTHLY_DRILLS=30
# Coach lessons (docs/coach-mode.md): the coach teaches a plan's sections and checks them.
# Their own monthly allowance; the interviewer's model unless INTERVIEW_COACH_MODEL is set; a teaching
# turn runs longer than a question, and a lesson's budget is above an interview's (cost-model.md).
INTERVIEW_COACH_MONTHLY_SESSIONS=10
# INTERVIEW_COACH_MODEL=
INTERVIEW_COACH_MAX_TOKENS=500
INTERVIEW_COACH_SESSION_BUDGET_USD=4
# The coach draws by calling a `draw` tool (it hears what landed and what was dropped inside the turn, at a
# second model call per drawing) instead of <draw> elements in its words. Off: elements (coach-mode.md, phase 4).
# INTERVIEW_COACH_DRAW_TOOLS=false
INTERVIEW_MAX_TURNS=60
# Estimated spend: one session stops taking messages past its cap (feedback still runs), and
# the interview pauses until midnight UTC past the daily one (docs/cost-model.md).
INTERVIEW_SESSION_BUDGET_USD=1.5
INTERVIEW_DAILY_BUDGET_USD=10
# Transcripts and feedback are deleted this many days after a session starts (and at once when
# the reader deletes the session or the account).
INTERVIEW_RETENTION_DAYS=30
# Minutes past the planned length after which a session takes no more messages.
INTERVIEW_OVERTIME_MINUTES=15
# Early access: readers who may start, as emails, comma-separated, plus the store's list
# (`node scripts/interview-switch.mjs allow add <email>`). Both empty: every signed-in reader may.
# Staff always may. Others see the landing with an early-access note.
INTERVIEW_ALLOWLIST=

# ---- Voice (src/lib/server/interview/voice.ts, voice/; docs/README.md "Voice")
# Only used by a build with PUBLIC_INTERVIEW_VOICE_ENABLED=true. This app owns the session, the
# quota and the budget and mints the Daily room and tokens; the voice service (voice/,
# INTERVIEW_VOICE_URL) runs the audio pipeline and calls back /api/internal/interview/* with the
# shared bearer. Pro only.
# Runtime pause; the store flag from `node scripts/interview-switch.mjs voice on|off` overrides it.
INTERVIEW_VOICE_ENABLED=true
# The voice service (Service Connect in AWS, http://voice:7860 under docker compose,
# http://localhost:7860 in dev) and the bearer both sides check (32+ characters; the same value in
# the service's environment).
INTERVIEW_VOICE_URL=
INTERVIEW_VOICE_SECRET=
# Daily (the WebRTC rooms; this app creates a private room per session and the two meeting tokens).
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1
# The speech vendors are the voice service's (DEEPGRAM_API_KEY, CARTESIA_API_KEY, SARVAM_API_KEY,
# SMALLEST_API_KEY in its environment, picked with VOICE_STT and VOICE_TTS; voice/README.md);
# this app checks any copy it is given for placeholders only.
# Voice sessions a Pro reader may start per calendar month (UTC), the minutes reserved for them,
# and exchanges (candidate turns) per voice session.
INTERVIEW_VOICE_MONTHLY_SESSIONS=5
INTERVIEW_VOICE_MONTHLY_MINUTES=225
INTERVIEW_VOICE_MAX_EXCHANGES=90
# Output tokens per spoken reply (voice replies are short).
INTERVIEW_VOICE_MAX_TOKENS=350
# Estimated spend (model tokens plus speech at the list prices below): one voice session stops
# taking turns past its cap, and voice pauses until midnight UTC past the daily one; both are
# inside the interview and Ask budgets (docs/cost-model.md, "Voice").
INTERVIEW_VOICE_SESSION_BUDGET_USD=3
INTERVIEW_VOICE_DAILY_BUDGET_USD=30
# Speech list prices the heartbeats are charged at: Deepgram Nova-3 per audio minute, Cartesia
# Sonic per 1,000 characters.
VOICE_STT_USD_PER_MIN=0.0077
VOICE_TTS_USD_PER_1K_CHARS=0.03
# ---- end Mock interview --------------------------------------------------------------------

# Graceful shutdown (scripts/serve.ts): on SIGTERM keep serving with /api/ready failing for the
# delay, then let requests in flight finish; exit at most the grace after the signal.
SHUTDOWN_DELAY_MS=5000
SHUTDOWN_GRACE_MS=30000

# Logging and error tracking (all optional; Sentry is off unless a DSN is set).
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Client-side Sentry; read at build time. Often the same DSN as SENTRY_DSN.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=
# Release id attached to errors and logs (e.g. the git SHA); PUBLIC_RELEASE is the build-time copy.
RELEASE=
PUBLIC_RELEASE=

# Real-user Core Web Vitals (src/lib/rum.ts -> /api/rum -> "web-vital" log lines). Share of page
# views the browser measures, read at build time (0 turns it off; default 0.1).
PUBLIC_RUM_SAMPLE_RATE=0.1

# Share of consenting browsers that send events, read at build time (0 turns it off; default 1).
PUBLIC_ANALYTICS_SAMPLE_RATE=1

# The voice room's vendors (phase 3; docs/README.md "Voice"). Daily carries the audio (the
# bot dials out to a room), Deepgram Nova-3 transcribes (Indian English), Cartesia Sonic speaks.
# Read by the voice service (voice/); this app only checks they are not placeholders. Leave
# unset until the voice beta: nothing in the text room uses them. (DAILY_API_KEY is above.)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# India-hosted alternatives (voice/README.md "Settings"): Sarvam (saaras transcription,
# bulbul voices) and Smallest (pulse, lightning). The voice service picks them with VOICE_STT and
# VOICE_TTS (deepgram|flux|sarvam|smallest and cartesia|sarvam|smallest; defaults deepgram, cartesia;
# flux is Deepgram's conversational transcriber, which ends the turn itself and predicts the end first).
SARVAM_API_KEY=
SMALLEST_API_KEY=
VOICE_STT=deepgram
VOICE_TTS=cartesia
# The Daily room's media server region (Daily's `geo`); Mumbai, with the service and the candidates.
DAILY_GEO=ap-south-1
